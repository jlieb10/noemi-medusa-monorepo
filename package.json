{
  "name": "noemi-medusa-monorepo",
  "version": "1.0.0",
  "description": "NOEMI Luxury Supplements E-commerce Platform - Medusa + Next.js + Supabase",
  "private": true,
  "author": "NOEMI Team",
  "license": "MIT",
  "keywords": [
    "ecommerce",
    "medusa",
    "nextjs",
    "supabase",
    "luxury",
    "supplements",
    "storefront",
    "monorepo",
    "medusa",
    "nextjs",
    "ecommerce",
    "monorepo",
    "strapi",
    "meilisearch",
    "posthog",
    "growthbook",
    "n8n",
    "docker"
  ],
  "scripts": {
    "backend:build": "cd noemi-medusa-backend && yarn build",
    "backend:dev": "cd noemi-medusa-backend && yarn dev",
    "build": "npm run build --workspace=noemi-medusa-backend && npm run build --workspace=noemi-medusa-storefront",
    "clean": "rm -rf noemi-medusa-backend/dist noemi-medusa-backend/.medusa noemi-medusa-storefront/.next",
    "dev": "concurrently \"npm run dev --workspace=noemi-medusa-backend\" \"npm run dev --workspace=noemi-medusa-storefront\"",
    "dev:backend": "npm run dev --workspace=noemi-medusa-backend",
    "dev:frontend": "npm run dev --workspace=noemi-medusa-storefront",
    "frontend:build": "cd noemi-medusa-storefront && yarn build",
    "frontend:dev": "cd noemi-medusa-storefront && yarn dev",
    "help": "./dev.sh help",
    "install:all": "yarn install && cd noemi-medusa-backend && yarn install && cd ../noemi-medusa-storefront && yarn install",
    "lint": "npm run lint --workspace=noemi-medusa-storefront",
    "logs": "./dev.sh logs",
    "restart": "./dev.sh restart",
    "seed": "npm run seed --workspace=noemi-medusa-backend",
    "services": "./dev.sh services",
    "setup": "./dev.sh setup",
    "start": "concurrently \"npm run start --workspace=noemi-medusa-backend\" \"npm run start --workspace=noemi-medusa-storefront\"",
    "start:backend": "npm run start --workspace=noemi-medusa-backend",
    "start:frontend": "npm run start --workspace=noemi-medusa-storefront",
    "status": "./dev.sh status",
    "stop": "./dev.sh stop",
    "test": "npm run test:unit --workspace=noemi-medusa-backend && npm run test --workspace=noemi-medusa-storefront",
    "test:e2e": "npm run test:e2e --workspace=noemi-medusa-storefront",
    "test:integration": "npm run test:integration:http --workspace=noemi-medusa-backend",
    "typecheck": "npm run typecheck --workspace=noemi-medusa-backend && npm run typecheck --workspace=noemi-medusa-storefront"
  },
  "workspaces": [
    "noemi-medusa-backend",
    "noemi-medusa-storefront"
  ],

  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlieb10/noemi-medusa-monorepo.git"
  }
}