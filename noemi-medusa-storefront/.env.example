# NOEMI Storefront Environment Template
# Copy this file to .env.local and fill in your values

# Medusa Backend Configuration
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Medusa Publishable Key (get from Medusa Admin)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_dev_your_publishable_key_here

# Stripe Configuration (Optional - for Phase 3)
# NEXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_public_key_here

# Environment
NODE_ENV=development

# Default region for storefront
NEXT_PUBLIC_DEFAULT_REGION=us

# Analytics (Optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# SEO Configuration (Optional)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXT_PUBLIC_SITE_NAME=NOEMI Supplements
# NEXT_PUBLIC_SITE_DESCRIPTION=Luxury supplements for optimal health and wellness